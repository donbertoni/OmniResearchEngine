# Copie para .env (nunca commitado -- ver .gitignore) e preencha o que for
# usar. Nada aqui é obrigatório para rodar localmente: sem DATABASE_URL o app
# cai para arquivos JSON locais (efêmeros); sem as demais, cada integração
# falha honestamente em vez de fingir sucesso.

# Postgres dedicado ao OMNI (recomendado -- ex: um projeto Neon próprio, NÃO
# reaproveite o banco de outro projeto). Sem isso, login/gatilhos/automações/
# pools de ativos/logs de ML vivem em arquivos JSON locais e não sobrevivem a
# um redeploy.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# BRAPI (cotações B3 -- fallback do yfinance para tickers .SA)
BRAPI_TOKEN=

# WhatsApp (gateway HTTP estilo Evolution API / UAZAPI)
WHATSAPP_API_BASE_URL=
WHATSAPP_INSTANCE_ID=
WHATSAPP_TOKEN=

# Telegram Bot API (https://core.telegram.org/bots/api)
TELEGRAM_BOT_TOKEN=

# SMTP para envio real de e-mail (qualquer provedor: Gmail app-password, SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Defina como 1 se rodar scheduler_worker.py como processo dedicado, para o
# Streamlit não duplicar o disparo do Auto-Pilot com seu scheduler embutido.
OMNI_DISABLE_INLINE_SCHEDULER=

# Segredo do "Manter-se conectado" do Streamlit (session_token_service.py, HMAC).
# Sem isso, um segredo por processo é gerado -- reiniciar o processo derruba
# todo mundo que marcou "manter conectado". Qualquer string longa aleatória serve.
OMNI_SESSION_SECRET=

# Par de chaves RSA (PEM) para assinar os JWTs de sessão multi-tenant
# (omni/application/token_service.py -- ainda não usado por ui/, preparado
# para a Fase 1). Sem isso, um par é gerado por processo (mesma limitação do
# OMNI_SESSION_SECRET acima). Gerar com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
OMNI_JWT_PRIVATE_KEY=
OMNI_JWT_PUBLIC_KEY=
